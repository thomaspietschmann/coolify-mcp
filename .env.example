# --- Coolify MCP server configuration ---------------------------------------
# Copy this file to .env and fill in your values.
# .env is in .gitignore and never reaches the LLM context.

# Base URL of your Coolify instance (without trailing slash).
# Self-hosted example:  https://coolify.example.com
# Cloud example:        https://app.coolify.io
COOLIFY_BASE_URL=https://coolify.example.com

# API token from Coolify: Keys & Tokens -> API Tokens -> Create.
# For deploy/write access pick a token with "read:write" scope (not "read-only").
COOLIFY_API_TOKEN=your-coolify-api-token-here

# Optional read-only switch. Set to "false" to fully disable ALL write and
# deploy tools (the server then exposes read access only).
# Default: true (write/deploy allowed, but every action requires confirm:true).
COOLIFY_ALLOW_MUTATIONS=true

# Optional request timeout in milliseconds (default: 30000).
COOLIFY_TIMEOUT_MS=30000
